# ============================================================
# 城市天气与空气质量数据平台 —— 环境变量样例
# 复制为 .env 后按需修改。所有变量均有可用默认值，
# 无 .env 亦可直接启动（零配置门槛）。
#
# 平台由两个可独立部署的服务组成：
#   分析平台（analysis）   —— 业务分析，默认 8000
#   治理平台（governance） —— 数据治理，默认 8001
# 两者共享同一份数据湖与资产目录，因此存储配置只有一份。
# ============================================================

# ---------- 运行环境 ----------
ATMOS_ENV=dev
ATMOS_LOG_LEVEL=INFO
ATMOS_HOST=127.0.0.1
# 分析平台端口
ATMOS_PORT=8000
# 治理平台端口
ATMOS_GOVERNANCE_PORT=8001

# 启动服务后自动用默认浏览器打开看板。
# 服务器 / CI / 无图形界面的环境请设为 false，或用命令行 --no-open。
ATMOS_OPEN_BROWSER=true

# ---------- 前端访问地址 ----------
# 留空时按 host:port 自动推断；两个服务部署在不同机器时显式填写，
# 否则统一前端的顶栏切换找不到另一个后端。
ATMOS_ANALYSIS_PUBLIC_URL=
ATMOS_GOVERNANCE_PUBLIC_URL=

# ---------- 跨源访问 ----------
# 允许的浏览器来源（逗号分隔）。两种留空含义不同，都是有意的：
#   ATMOS_ENV=dev  → 放开为 *，方便任意端口调试；
#   其他环境        → 不发 CORS 头，即只允许同源访问。
# 反向代理按路径分流两个门户（同源，推荐）时保持留空即可；
# 两个服务分处不同域名/端口时必须显式填写，例如：
#   ATMOS_CORS_ORIGINS=https://atmos.example.com,https://gov.example.com
ATMOS_CORS_ORIGINS=

# ---------- 访问控制 ----------
# 应用内 HTTP Basic 认证：两项同时填写才生效，留空则整个平台无鉴权。
# 注意 Basic 认证在明文 HTTP 下只是 base64，不提供加密；要真正安全请上 HTTPS。
ATMOS_AUTH_USER=
ATMOS_AUTH_PASSWORD=

# ---------- 存储路径（相对项目根目录，两个平台共用） ----------
# Parquet 数据湖根目录：承载全部原始 / 精炼 / 服务层数据集
ATMOS_LAKE_DIR=data/lake
# SQLite 资产目录库：承载元数据、血缘、质量、运行记录
ATMOS_CATALOG_DB=data/catalog.db
# 配置文件目录
ATMOS_CONFIG_DIR=config

# ---------- Open-Meteo 数据源 ----------
# 非商业用途免 API Key；如需商业版请填写并在下方切换 host
ATMOS_OPENMETEO_API_KEY=
ATMOS_OPENMETEO_FORECAST_HOST=https://api.open-meteo.com
ATMOS_OPENMETEO_ARCHIVE_HOST=https://archive-api.open-meteo.com
ATMOS_OPENMETEO_AIR_HOST=https://air-quality-api.open-meteo.com
ATMOS_OPENMETEO_GEOCODING_HOST=https://geocoding-api.open-meteo.com

# 请求治理：超时、重试、限流（Open-Meteo 免费额度约 600 次/分钟）
ATMOS_HTTP_TIMEOUT_SECONDS=30
ATMOS_HTTP_MAX_RETRIES=4
ATMOS_HTTP_MIN_INTERVAL_MS=120

# ---------- 采集策略 ----------
# 单次采集的城市上限（保护免费额度）
ATMOS_COLLECT_MAX_CITIES=20
# 历史归档回补天数。ERA5 归档有约 5 天发布延迟，窗口会自动避开。
# 调到 400 可支持"同比"分析（代价是首次采集时间显著变长）。
ATMOS_ARCHIVE_LOOKBACK_DAYS=180
# 空气质量历史天数（数据源上限 92）。这一项决定了融合宽表与日汇总能回溯多久，
# 直接决定"达标考核""污染过程识别"等分析能覆盖多长的周期。
ATMOS_AIR_QUALITY_HISTORY_DAYS=92
# 预报天数
ATMOS_FORECAST_HORIZON_DAYS=7
# 预报接口回溯天数（近实时实况）
ATMOS_FORECAST_PAST_DAYS=2

# ---------- 调度 ----------
# 由 `python -m atmos schedule` 这个常驻进程消费；不跑该命令就没有任何自动任务。
# 值留空 = 停用该作业。标准 5 段 cron（分 时 日 月 周）。
ATMOS_SCHEDULE_COLLECT_CRON=15 * * * *
ATMOS_SCHEDULE_QUALITY_CRON=30 * * * *
# 每天回补一次 ERA5 归档：上游有约 5 天发布延迟，没必要每小时重拉 180 天窗口
ATMOS_SCHEDULE_ARCHIVE_CRON=20 4 * * *
