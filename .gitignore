# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ============================================================
# 平台运行时产物：数据湖、资产目录库、导出文件
# ------------------------------------------------------------
# 注意这里用 `data/*` 而不是 `data/`：
# Git 的规则是"父目录被排除时，无法再重新包含其中的文件"，
# 因此 `data/` + `!data/.gitkeep` 是**无效**的（gitkeep 仍会被忽略）。
# 写成 `data/*` 才能让 `!data/.gitkeep` 真正生效。
# ============================================================
data/*
!data/.gitkeep

# 数据库与临时文件（即使被放到 data/ 之外也不入库）
*.db
*.db-wal
*.db-shm
*.db-journal
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3

# 导出与日志
data/exports/
*.log

# ============================================================
# 环境变量：只提交 .env.example，真实配置不入库
# ============================================================
.env
.env.local
.env.*.local

# ============================================================
# 编辑器 / 系统
# ============================================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
